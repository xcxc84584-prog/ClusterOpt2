root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,css,html}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# OCDA modules created from PR2 onward use Tab-aligned indentation.
[Implementation/property/UI_COLOR.js]
indent_style = tab
tab_width = 2

[Implementation/object/InterfacePalette.js]
indent_style = tab
tab_width = 2

[Implementation/main/palette-ui.js]
indent_style = tab
tab_width = 2

[Implementation/tests/palette.test.js]
indent_style = tab
tab_width = 2

[Implementation/property/Language.js]
indent_style = tab
tab_width = 2

[Implementation/object/LanguageManager.js]
indent_style = tab
tab_width = 2

[Implementation/main/language-ui.js]
indent_style = tab
tab_width = 2

[Implementation/tests/language.test.js]
indent_style = tab
tab_width = 2
